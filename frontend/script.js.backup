const API_BASE = '/api';

// Mostrar información de la base de datos al cargar
document.addEventListener('DOMContentLoaded', function() {
    cargarInfoDB();
    
    // Manejar envío del formulario
    document.getElementById('userForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        console.log('Formulario enviado');
        
        const formData = new FormData(e.target);
        const userData = {
            nombre: formData.get('nombre'),
            edad: parseInt(formData.get('edad')),
            peso: parseFloat(formData.get('peso')),
            altura: parseFloat(formData.get('altura')),
            sexo: formData.get('sexo'),
            nivelActividad: formData.get('nivelActividad'),
            objetivo: formData.get('objetivo')
        };
        
        console.log('Datos del usuario:', userData);
        await procesarUsuario(userData);
    });
});

// Mostrar plan semanal
function mostrarPlanSemanal(planSemanal) {
    const resultadosDiv = document.getElementById('resultados');
    const contentDiv = document.getElementById('plan-content');
    
    let html = `
        <div class="plan-summary fade-in">
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <h5><i class="fas fa-fire"></i> Calorías Promedio Diario</h5>
                            <h2>${planSemanal.promedioSemanal.calorias} kcal</h2>
                            <small>Objetivo: ${planSemanal.requerimientos.calorias} kcal</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <h5><i class="fas fa-chart-pie"></i> Puntuación Semanal</h5>
                            <h2>${planSemanal.cumplimientoSemanal.general}%</h2>
                            <small>Cumplimiento nutricional</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-info text-white">
                        <div class="card-body">
                            <h5><i class="fas fa-calendar-week"></i> Plan Semanal</h5>
                            <h2>7 días</h2>
                            <small>Menú completo</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navegación por días -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5><i class="fas fa-calendar"></i> Seleccionar Día de la Semana</h5>
                </div>
                <div class="card-body">
                    <div class="btn-group w-100" role="group">
                        ${Object.keys(planSemanal.planSemanal).map((dia, index) => `
                            <button type="button" class="btn btn-outline-primary dia-btn ${index === 0 ? 'active' : ''}" 
                                    onclick="mostrarDia('${dia}')" data-dia="${dia}">
                                ${dia}
                            </button>
                        `).join('')}
                    </div>
                </div>
            </div>
        </div>

        <!-- Contenedor para el día seleccionado -->
        <div id="dia-content">
            <!-- Aquí se mostrará el contenido del día seleccionado -->
        </div>
    `;
    
    contentDiv.innerHTML = html;
    resultadosDiv.style.display = 'block';
    
    // Guardar el plan semanal para uso posterior
    window.currentPlanSemanal = planSemanal;
    
    // Mostrar el primer día por defecto
    const primerDia = Object.keys(planSemanal.planSemanal)[0];
    mostrarDia(primerDia);
}

// Mostrar detalles de un día específico
function mostrarDia(dia) {
    const planSemanal = window.currentPlanSemanal;
    const planDiario = planSemanal.planSemanal[dia];
    
    // Actualizar botones activos
    document.querySelectorAll('.dia-btn').forEach(btn => {
        btn.classList.remove('active');
    });
    document.querySelector(`[data-dia="${dia}"]`).classList.add('active');
    
    const diaContentDiv = document.getElementById('dia-content');
    
    let html = `
        <div class="day-plan fade-in">
            <h3 class="mb-4">
                <i class="fas fa-calendar-day"></i> ${dia}
                <span class="badge bg-primary ms-2">${planDiario.resumenNutricional.calorias} kcal</span>
                <span class="badge bg-success ms-1">${planDiario.cumplimiento.general}% cumplimiento</span>
            </h3>
            
            <div class="row">
    `;
    
    // Mostrar cada comida del día
    for (const [comida, detalles] of Object.entries(planDiario.comidas)) {
        html += `
            <div class="col-lg-6 mb-4">
                <div class="card meal-card">
                    <div class="card-header meal-header-${comida}">
                        <h5>${obtenerIconoComida(comida)} ${comida.charAt(0).toUpperCase() + comida.slice(1)}</h5>
                        <div class="meal-stats">
                            <span class="badge bg-light text-dark">${detalles.nutrientesReales.calorias || 0} kcal</span>
                            <span class="badge bg-info">${detalles.nutrientesReales.proteinas || 0}g prot</span>
                        </div>
                    </div>
                    <div class="card-body">
                        ${detalles.alimentos.map(alimento => `
                            <div class="alimento-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>${alimento.nombre}</strong>
                                        <small class="text-muted d-block">${alimento.cantidad}g</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-primary">${alimento.nutrientes.calorias} kcal</span>
                                        <button class="btn btn-sm btn-outline-info ms-2" onclick="mostrarDetalleAlimento('${alimento.codigo}', ${alimento.cantidad})">
                                            <i class="fas fa-info-circle"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="nutrient-mini-bars mt-2">
                                    <div class="mini-bar">
                                        <small>P: ${alimento.nutrientes.proteinas}g</small>
                                        <div class="progress progress-sm">
                                            <div class="progress-bar bg-success" style="width: ${(alimento.nutrientes.proteinas / 50) * 100}%"></div>
                                        </div>
                                    </div>
                                    <div class="mini-bar">
                                        <small>C: ${alimento.nutrientes.carbohidratos}g</small>
                                        <div class="progress progress-sm">
                                            <div class="progress-bar bg-warning" style="width: ${(alimento.nutrientes.carbohidratos / 100) * 100}%"></div>
                                        </div>
                                    </div>
                                    <div class="mini-bar">
                                        <small>G: ${alimento.nutrientes.grasas}g</small>
                                        <div class="progress progress-sm">
                                            <div class="progress-bar bg-danger" style="width: ${(alimento.nutrientes.grasas / 30) * 100}%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            </div>
        `;
    }
    
    html += `
            </div>
        </div>
    `;
    
    diaContentDiv.innerHTML = html;
}

// Mostrar plan generado con información nutricional completa
function mostrarPlan(plan) {
    const resultadosDiv = document.getElementById('resultados');
    const contentDiv = document.getElementById('plan-content');
    
    let html = `
        <div class="plan-summary fade-in">
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <h5><i class="fas fa-fire"></i> Calorías Diarias</h5>
                            <h2>${plan.requerimientos.calorias} kcal</h2>
                            <small>Real: ${plan.resumenNutricional.calorias} kcal</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <h5><i class="fas fa-chart-pie"></i> Puntuación General</h5>
                            <h2>${plan.cumplimiento.general}%</h2>
                            <small>Cumplimiento nutricional</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Macronutrientes -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5><i class="fas fa-chart-bar"></i> Distribución de Macronutrientes</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="text-center">
                                <div class="progress-circle" data-percent="${plan.cumplimiento.macronutrientes.proteinas.porcentaje}">
                                    <span class="progress-text">
                                        <strong>${plan.resumenNutricional.proteinas}g</strong><br>
                                        <small>Proteínas</small>
                                    </span>
                                </div>
                                <p class="mt-2 small">Objetivo: ${plan.requerimientos.macronutrientes.proteinas}g</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center">
                                <div class="progress-circle" data-percent="${plan.cumplimiento.macronutrientes.carbohidratos.porcentaje}">
                                    <span class="progress-text">
                                        <strong>${plan.resumenNutricional.carbohidratos}g</strong><br>
                                        <small>Carbohidratos</small>
                                    </span>
                                </div>
                                <p class="mt-2 small">Objetivo: ${plan.requerimientos.macronutrientes.carbohidratos}g</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center">
                                <div class="progress-circle" data-percent="${plan.cumplimiento.macronutrientes.grasas.porcentaje}">
                                    <span class="progress-text">
                                        <strong>${plan.resumenNutricional.grasas}g</strong><br>
                                        <small>Grasas</small>
                                    </span>
                                </div>
                                <p class="mt-2 small">Objetivo: ${plan.requerimientos.macronutrientes.grasas}g</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Micronutrientes -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5><i class="fas fa-pills"></i> Micronutrientes Clave</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        ${generarMicronutrientes(plan.cumplimiento.micronutrientes, plan.resumenNutricional.micronutrientes)}
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
    `;
    
    // Mostrar cada comida con detalles nutricionales
    for (const [comida, detalles] of Object.entries(plan.comidas)) {
        console.log(`Comida ${comida}:`, detalles);
        console.log(`Calorías de ${comida}:`, detalles.nutrientesReales?.calorias);
        
        html += `
            <div class="col-lg-6 mb-4">
                <div class="card meal-card">
                    <div class="card-header meal-header-${comida}">
                        <h5>${obtenerIconoComida(comida)} ${comida.charAt(0).toUpperCase() + comida.slice(1)}</h5>
                        <div class="meal-stats">
                            <span class="badge bg-light text-dark">${detalles.nutrientesReales.calorias || 0} kcal</span>
                            <span class="badge bg-info">${detalles.nutrientesReales.proteinas || 0}g prot</span>
                        </div>
                    </div>
                    <div class="card-body">
                        ${detalles.alimentos.map(alimento => `
                            <div class="alimento-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>${alimento.nombre}</strong>
                                        <small class="text-muted d-block">${alimento.cantidad}g</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-primary">${alimento.nutrientes.calorias} kcal</span>
                                        <button class="btn btn-sm btn-outline-info ms-2" onclick="mostrarDetalleAlimento('${alimento.codigo}', ${alimento.cantidad})">
                                            <i class="fas fa-info-circle"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="nutrient-mini-bars mt-2">
                                    <div class="mini-bar">
                                        <small>P: ${alimento.nutrientes.proteinas}g</small>
                                        <div class="progress progress-sm">
                                            <div class="progress-bar bg-success" style="width: ${(alimento.nutrientes.proteinas / detalles.targets.proteinas) * 100}%"></div>
                                        </div>
                                    </div>
                                    <div class="mini-bar">
                                        <small>C: ${alimento.nutrientes.carbohidratos}g</small>
                                        <div class="progress progress-sm">
                                            <div class="progress-bar bg-warning" style="width: ${(alimento.nutrientes.carbohidratos / detalles.targets.carbohidratos) * 100}%"></div>
                                        </div>
                                    </div>
                                    <div class="mini-bar">
                                        <small>G: ${alimento.nutrientes.grasas}g</small>
                                        <div class="progress progress-sm">
                                            <div class="progress-bar bg-danger" style="width: ${(alimento.nutrientes.grasas / detalles.targets.grasas) * 100}%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `).join('')}
                        
                        <!-- Análisis de la comida -->
                        <div class="meal-analysis mt-3">
                            <h6>Análisis Nutricional:</h6>
                            <div class="row">
                                <div class="col-6">
                                    <small class="text-success">Logrado:</small>
                                    <ul class="small mb-0">
                                        ${Object.entries(detalles.analisis).filter(([k,v]) => v.cumple).map(([k,v]) => 
                                            `<li>${k}: ${v.porcentaje}%</li>`
                                        ).join('')}
                                    </ul>
                                </div>
                                <div class="col-6">
                                    <small class="text-warning">A mejorar:</small>
                                    <ul class="small mb-0">
                                        ${Object.entries(detalles.analisis).filter(([k,v]) => !v.cumple).map(([k,v]) => 
                                            `<li>${k}: ${v.porcentaje}%</li>`
                                        ).join('')}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        `;
    }
    
    html += `
        </div>
        
        <!-- Botones de acción -->
        <div class="text-center mt-4">
            <button class="btn btn-success btn-lg me-3" onclick="regenerarPlan()">
                <i class="fas fa-refresh"></i> Generar Nuevo Plan
            </button>
            <button class="btn btn-info btn-lg me-3" onclick="descargarPlan()">
                <i class="fas fa-download"></i> Descargar PDF
            </button>
            <button class="btn btn-outline-primary btn-lg" onclick="compartirPlan()">
                <i class="fas fa-share"></i> Compartir
            </button>
        </div>
    `;
    
    contentDiv.innerHTML = html;
    resultadosDiv.style.display = 'block';
    
    // Inicializar círculos de progreso
    initProgressCircles();
    
    // Scroll suave a los resultados
    resultadosDiv.scrollIntoView({ behavior: 'smooth' });
}istener('DOMContentLoaded', async () => {
    await cargarInfoDB();
});

// Cargar información de la base de datos
async function cargarInfoDB() {
    try {
        const response = await fetch(`${API_BASE}/info`);
        const data = await response.json();
        
        document.getElementById('db-info').innerHTML = 
            `<i class="fas fa-database"></i> Base de datos conectada - ${data.totalAlimentos} alimentos disponibles`;
    } catch (error) {
        document.getElementById('db-info').innerHTML = 
            '<i class="fas fa-exclamation-triangle"></i> Error al conectar con la base de datos';
        document.getElementById('db-info').className = 'alert alert-warning';
    }
}

// Procesar usuario y generar plan
async function procesarUsuario(userData) {
    console.log('Iniciando procesamiento del usuario');
    mostrarLoading(true);
    limpiarAlertas();
    
    try {
        console.log('Creando usuario...');
        // 1. Crear o verificar usuario
        await crearUsuario(userData);
        
        console.log('Generando plan nutricional...');
        // 2. Generar plan nutricional
        const planResponse = await fetch(`${API_BASE}/generar-plan`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ nombre: userData.nombre })
        });
        
        if (!planResponse.ok) {
            throw new Error('Error al generar plan nutricional');
        }
        
        const planData = await planResponse.json();
        console.log('Plan generado exitosamente:', planData);
        
        // Verificar si es un plan semanal o diario
        if (planData.plan.planSemanal) {
            console.log('Mostrando plan semanal');
            mostrarPlanSemanal(planData.plan);
        } else {
            console.log('Mostrando plan diario');
            console.log('Estructura de comidas:', planData.plan.comidas);
            mostrarPlan(planData.plan);
        }
        
    } catch (error) {
        console.error('Error en procesarUsuario:', error);
        mostrarAlerta('error', `Error: ${error.message}`);
    } finally {
        mostrarLoading(false);
    }
}

// Crear usuario
async function crearUsuario(userData) {
    const response = await fetch(`${API_BASE}/usuarios`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(userData)
    });
    
    if (!response.ok) {
        const errorData = await response.json();
        if (response.status === 400 && errorData.error.includes('ya existe')) {
            // Usuario ya existe, esto está bien
            return;
        }
        throw new Error(errorData.error);
    }
}

// Mostrar plan generado
function mostrarPlan(plan) {
    const resultadosDiv = document.getElementById('resultados');
    const contentDiv = document.getElementById('plan-content');
    
    let html = `
        <div class="plan-summary fade-in">
            <h4><i class="fas fa-user-check"></i> ${plan.nombre}</h4>
            <div class="row mt-3">
                <div class="col-md-4">
                    <div class="calorias-badge">
                        <i class="fas fa-fire"></i> ${plan.resumenNutricional.calorias} kcal/día
                    </div>
                </div>
                <div class="col-md-8">
                    <p class="mb-0">Plan personalizado generado con ${Object.keys(plan.comidas).length} comidas</p>
                </div>
            </div>
        </div>
    `;
    
    // Agregar cada comida
    const iconosComidas = {
        desayuno: 'fa-coffee',
        almuerzo: 'fa-utensils',
        cena: 'fa-moon',
        snacks: 'fa-cookie-bite'
    };
    
    for (const [nombreComida, detalles] of Object.entries(plan.comidas)) {
        const icono = iconosComidas[nombreComida] || 'fa-utensils';
        
        html += `
            <div class="comida-card fade-in">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fas ${icono} comida-icon"></i>
                        ${nombreComida.charAt(0).toUpperCase() + nombreComida.slice(1)}
                        <span class="float-end calorias-badge">
                            ${detalles.nutrientesReales.calorias || 0}/${detalles.targets.calorias || 0} kcal
                        </span>
                    </h5>
                    <div class="alimentos-list">
        `;
        
        detalles.alimentos.forEach(alimento => {
            const proteina = alimento.proteina_g ? (alimento.proteina_g * alimento.cantidad / 100).toFixed(1) : '0';
            const carbos = alimento.carbohidratos_g ? (alimento.carbohidratos_g * alimento.cantidad / 100).toFixed(1) : '0';
            const grasas = alimento.grasa_total_g ? (alimento.grasa_total_g * alimento.cantidad / 100).toFixed(1) : '0';
            
            html += `
                <div class="alimento-item">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <strong>${alimento.nombre}</strong>
                            <br>
                            <small class="text-muted">${alimento.cantidad}g - ${alimento.nutrientes.calorias || 0} kcal</small>
                        </div>
                    </div>
                    <div class="nutritional-info">
                        <span class="protein">${proteina}g proteína</span>
                        <span class="carbs">${carbos}g carbohidratos</span>
                        <span class="fat">${grasas}g grasas</span>
                    </div>
                </div>
            `;
        });
        
        html += `
                    </div>
                </div>
            </div>
        `;
    }
    
    // Agregar botón para nuevo plan
    html += `
        <div class="text-center mt-4">
            <button class="btn btn-outline-success" onclick="generarNuevoPlan()">
                <i class="fas fa-redo"></i> Generar Nuevo Plan
            </button>
        </div>
    `;
    
    contentDiv.innerHTML = html;
    resultadosDiv.style.display = 'block';
    
    // Scroll suave a los resultados
    resultadosDiv.scrollIntoView({ behavior: 'smooth' });
}

// Generar nuevo plan
async function generarNuevoPlan() {
    const email = document.getElementById('email').value;
    if (!email) {
        mostrarAlerta('warning', 'Por favor ingresa tu email');
        return;
    }
    
    mostrarLoading(true);
    
    try {
        const response = await fetch(`${API_BASE}/generar-plan`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ email })
        });
        
        if (!response.ok) {
            throw new Error('Error al generar nuevo plan');
        }
        
        const data = await response.json();
        mostrarPlan(data.plan);
        mostrarAlerta('success', '¡Nuevo plan generado exitosamente!');
        
    } catch (error) {
        mostrarAlerta('error', `Error: ${error.message}`);
    } finally {
        mostrarLoading(false);
    }
}

// Mostrar/ocultar loading
function mostrarLoading(mostrar) {
    document.getElementById('loading').style.display = mostrar ? 'block' : 'none';
}

// Mostrar alertas
function mostrarAlerta(tipo, mensaje) {
    const alertsDiv = document.getElementById('alerts');
    const alertClass = {
        'success': 'alert-success',
        'error': 'alert-danger',
        'warning': 'alert-warning',
        'info': 'alert-info'
    }[tipo] || 'alert-info';
    
    const alertHTML = `
        <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
            ${mensaje}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    `;
    
    alertsDiv.innerHTML = alertHTML;
    
    // Auto-remover después de 5 segundos
    setTimeout(() => {
        const alert = alertsDiv.querySelector('.alert');
        if (alert) {
            alert.remove();
        }
    }, 5000);
}

// Limpiar alertas
function limpiarAlertas() {
    document.getElementById('alerts').innerHTML = '';
}

// Generar HTML para micronutrientes
function generarMicronutrientes(cumplimiento, valores) {
    const micronutrientes = [
        { key: 'calcio', nombre: 'Calcio', unidad: 'mg', icono: 'fas fa-bone' },
        { key: 'hierro', nombre: 'Hierro', unidad: 'mg', icono: 'fas fa-tint' },
        { key: 'zinc', nombre: 'Zinc', unidad: 'mg', icono: 'fas fa-shield-alt' },
        { key: 'vitamina_c', nombre: 'Vitamina C', unidad: 'mg', icono: 'fas fa-lemon' },
        { key: 'vitamina_a', nombre: 'Vitamina A', unidad: 'µg', icono: 'fas fa-eye' },
        { key: 'folato', nombre: 'Folato', unidad: 'µg', icono: 'fas fa-dna' },
        { key: 'fibra', nombre: 'Fibra', unidad: 'g', icono: 'fas fa-leaf' },
        { key: 'potasio', nombre: 'Potasio', unidad: 'mg', icono: 'fas fa-heartbeat' }
    ];
    
    return micronutrientes.map(nutriente => {
        const datos = cumplimiento[nutriente.key];
        const valor = valores[nutriente.key] || 0;
        const porcentaje = datos ? datos.porcentaje : 0;
        const color = porcentaje >= 80 ? 'success' : porcentaje >= 60 ? 'warning' : 'danger';
        
        return `
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="micronutrient-card">
                    <div class="d-flex align-items-center">
                        <i class="${nutriente.icono} text-${color} me-2"></i>
                        <div>
                            <strong>${Math.round(valor * 100) / 100}${nutriente.unidad}</strong>
                            <small class="d-block text-muted">${nutriente.nombre}</small>
                        </div>
                    </div>
                    <div class="progress mt-1" style="height: 4px;">
                        <div class="progress-bar bg-${color}" style="width: ${Math.min(porcentaje, 100)}%"></div>
                    </div>
                    <small class="text-muted">${porcentaje}% del objetivo</small>
                </div>
            </div>
        `;
    }).join('');
}

// Obtener icono para cada comida
function obtenerIconoComida(comida) {
    const iconos = {
        'desayuno': '<i class="fas fa-coffee"></i>',
        'almuerzo': '<i class="fas fa-utensils"></i>',
        'cena': '<i class="fas fa-moon"></i>',
        'snacks': '<i class="fas fa-cookie-bite"></i>'
    };
    return iconos[comida] || '<i class="fas fa-utensils"></i>';
}

// Mostrar detalle nutricional de un alimento
async function mostrarDetalleAlimento(codigo, cantidad) {
    try {
        const response = await fetch(`${API_BASE}/alimentos/${codigo}/analisis?cantidad=${cantidad}`);
        const data = await response.json();
        
        mostrarModalAlimento(data.alimento, data.recomendaciones);
    } catch (error) {
        console.error('Error al obtener detalle del alimento:', error);
        mostrarAlerta('error', 'Error al cargar información del alimento');
    }
}

// Modal para mostrar información detallada del alimento
function mostrarModalAlimento(alimento, recomendaciones) {
    const modalHtml = `
        <div class="modal fade" id="alimentoModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">${alimento.nombre} - ${alimento.cantidad}g</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Macronutrientes</h6>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Calorías</span>
                                        <strong>${alimento.nutrientes.calorias} kcal</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Proteínas</span>
                                        <strong>${alimento.nutrientes.proteinas}g</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Carbohidratos</span>
                                        <strong>${alimento.nutrientes.carbohidratos}g</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Grasas</span>
                                        <strong>${alimento.nutrientes.grasas}g</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Fibra</span>
                                        <strong>${alimento.nutrientes.fibra}g</strong>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6>Micronutrientes</h6>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>🦴 Calcio</span>
                                        <strong>${alimento.nutrientes.calcio}mg</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>🩸 Hierro</span>
                                        <strong>${alimento.nutrientes.hierro}mg</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Vitamina C</span>
                                        <strong>${alimento.nutrientes.vitamina_c}mg</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Vitamina A</span>
                                        <strong>${alimento.nutrientes.vitamina_a}µg</strong>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Potasio</span>
                                        <strong>${alimento.nutrientes.potasio}mg</strong>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        
                        <div class="mt-4">
                            <h6>Evaluación Nutricional</h6>
                            <div class="alert alert-${recomendaciones.categoria.toLowerCase() === 'excelente' ? 'success' : 
                                                 recomendaciones.categoria.toLowerCase() === 'bueno' ? 'info' : 'warning'}">
                                <strong>Categoría: ${recomendaciones.categoria}</strong> 
                                (${recomendaciones.puntuacion} puntos)
                            </div>
                            
                            ${recomendaciones.fortalezas && recomendaciones.fortalezas.length > 0 ? `
                                <h6 class="text-success">Fortalezas:</h6>
                                <ul>${recomendaciones.fortalezas.map(f => `<li>${f}</li>`).join('')}</ul>
                            ` : ''}
                            
                            ${recomendaciones.recomendaciones && recomendaciones.recomendaciones.length > 0 ? `
                                <h6 class="text-info">Recomendaciones:</h6>
                                <ul>${recomendaciones.recomendaciones.map(r => `<li>${r}</li>`).join('')}</ul>
                            ` : ''}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    `;
    
    // Remover modal existente si hay uno
    const existingModal = document.getElementById('alimentoModal');
    if (existingModal) {
        existingModal.remove();
    }
    
    // Agregar el nuevo modal
    document.body.insertAdjacentHTML('beforeend', modalHtml);
    
    // Mostrar el modal
    const modal = new bootstrap.Modal(document.getElementById('alimentoModal'));
    modal.show();
}

// Inicializar círculos de progreso
function initProgressCircles() {
    document.querySelectorAll('.progress-circle').forEach(circle => {
        const percent = Math.min(parseInt(circle.dataset.percent) || 0, 100);
        circle.style.background = `conic-gradient(
            ${percent >= 80 ? '#28a745' : percent >= 60 ? '#ffc107' : '#dc3545'} ${percent * 3.6}deg,
            #e9ecef ${percent * 3.6}deg
        )`;
        circle.style.borderRadius = '50%';
        circle.style.position = 'relative';
        circle.style.width = '100px';
        circle.style.height = '100px';
        circle.style.display = 'flex';
        circle.style.alignItems = 'center';
        circle.style.justifyContent = 'center';
    });
}

// Descargar plan como PDF (placeholder)
function descargarPlan() {
    mostrarAlerta('info', 'Función de descarga en desarrollo. Próximamente podrás descargar tu plan en PDF.');
}

// Compartir plan (placeholder)
function compartirPlan() {
    if (navigator.share) {
        navigator.share({
            title: 'Mi Plan Nutricional Personalizado',
            text: 'Mira mi plan nutricional personalizado generado con análisis completo de nutrientes',
            url: window.location.href
        }).catch(err => {
            // Error silencioso en compartir
        });
    } else {
        // Fallback para navegadores que no soportan Web Share API
        const url = window.location.href;
        navigator.clipboard.writeText(url).then(() => {
            mostrarAlerta('success', 'Enlace copiado al portapapeles');
        }).catch(() => {
            mostrarAlerta('info', 'Comparte este enlace: ' + url);
        });
    }
}
